# V1: public sources with no API fees or required credentials.
METIS_SOURCES=hackernews,github,stackexchange
METIS_SUBREDDITS=SaaS,startups,smallbusiness,webdev,devops,selfhosted
METIS_STACKEXCHANGE_SITES=stackoverflow,serverfault

# Deferred: Reddit and X stay disabled even if their credentials are set.
# Enable them later only by explicitly adding them to METIS_SOURCES or --sources.
# Reddit requires approved access; free eligibility depends on the use case.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=python:metis:v0.2.0 (by /u/YOUR_REDDIT_USERNAME)
# Optional user-authorized refresh token instead of the app-only grant.
REDDIT_REFRESH_TOKEN=

# X recent search is paid and requires API access and usage credits.
X_BEARER_TOKEN=

# Optional for public GitHub/Stack Exchange reads; increases available quota.
GITHUB_TOKEN=
STACKEXCHANGE_KEY=

# Optional search overrides: valid JSON arrays, single-quoted for dotenv.
# METIS_GITHUB_QUERIES='["\"feature request\" \"workflow\" in:title,body"]'
# METIS_X_QUERIES='["(\"looking for\" OR \"wish there was\") (developer OR SaaS) lang:en -is:retweet"]'
# METIS_STACKEXCHANGE_QUERIES='["deployment workaround", "manual workflow"]'

# Optional persistent data location. Recommended for installed CLI use.
# METIS_DATA_DIR=/absolute/path/to/metis-data
# To load this file from another working directory, export before launching:
# export METIS_ENV_FILE=/absolute/path/to/metis.env
